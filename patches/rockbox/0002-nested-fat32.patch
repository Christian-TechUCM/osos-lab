 }
 
+#if defined(IPOD_6G) && defined(BOOTLOADER)
+static int nested_read(void *context, uint32_t lba, unsigned mult,
+                       bool boot, uint8_t *out)
+{
+    int drive = *(int *)context;
+    (void)drive;
+    (void)mult;
+    (void)boot;
+    uint8_t repeat[512] __attribute__((aligned(32)));
+    if (storage_read_sectors(IF_MD(drive,) lba, 1, out) ||
+        storage_read_sectors(IF_MD(drive,) lba, 1, repeat))
+        return -1;
+    return memcmp(out, repeat, 512) ? -1 : 0;
+}
+
+static bool mount_nested(int drive, int volume, struct partinfo *pinfo,
+                         unsigned *slot)
+{
+    (void)volume;
+    struct storage_info info;
+    storage_get_info(drive, &info);
+    if (info.sector_size != 512)
+        return false;
+    uint8_t outer[512] __attribute__((aligned(32)));
+    uint8_t bpb[512] __attribute__((aligned(32)));
+    struct ipod_nested_partition p;
+    if (nested_read(&drive, 0, 1, false, outer) ||
+        !ipod_nested_find(outer, info.num_sectors, nested_read, &drive, &p, bpb) ||
+        fat_mount(IF_MV(volume,) IF_MD(drive,) p.start))
+        return false;
+    for (unsigned i = 0; i < 4; ++i) {
+        pinfo[i].start *= p.mult;
+        pinfo[i].size *= p.mult;
+    }
+    pinfo[p.slot].start = p.start;
+    pinfo[p.slot].size = p.size;
+    disk_sector_multiplier[IF_MD_DRV(drive)] = p.mult;
+    *slot = p.slot;
+    return true;
+}
+#endif
