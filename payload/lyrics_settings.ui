<!-- SPDX-License-Identifier: GPL-3.0-only -->
<ui>
  <values id="cfw_lyrics_fonts">
    <value number="0" label="Small"/>
    <value number="1" label="Medium"/>
    <value number="2" label="Large"/>
  </values>
  <values id="cfw_lyrics_colors">
    <value number="0" label="Automatic"/>
    <value number="1" label="Blue"/>
    <value number="2" label="Cyan"/>
    <value number="3" label="Purple"/>
    <value number="4" label="Gold"/>
  </values>
  <values id="cfw_lyrics_switch">
    <value number="0" label="Off"/>
    <value number="1" label="On"/>
  </values>
  <values id="cfw_lyrics_backgrounds">
    <value number="0" label="Solid theme color"/>
    <value number="1" label="Album artwork"/>
  </values>
  <values id="cfw_lyrics_blur_levels">
    <value number="0" label="Low"/>
    <value number="1" label="Medium"/>
    <value number="2" label="High"/>
  </values>
  <values id="cfw_lyrics_save_status">
    <value number="0" label="Save settings"/>
    <value number="1" label="Save failed - retry"/>
  </values>
  <menu id="CFW_LyricsSettings" title="Lyrics">
    <selector id="CFW_LyricsSettings_Font" title="Text size" values="cfw_lyrics_fonts" slot="0" default="1"/>
    <selector id="CFW_LyricsSettings_Color" title="Lyric color" values="cfw_lyrics_colors" slot="1" default="0"/>
    <selector id="CFW_LyricsSettings_Artwork" title="Background" values="cfw_lyrics_backgrounds" slot="2" default="0"/>
    <selector id="CFW_LyricsSettings_Awake" title="Keep screen awake" values="cfw_lyrics_switch" slot="3" default="1"/>
    <selector id="CFW_LyricsSettings_Blur" title="Artwork blur" values="cfw_lyrics_blur_levels" slot="4" default="2"/>
    <action id="CFW_LyricsSettings_Save" title="Save settings" values="cfw_lyrics_save_status"/>
  </menu>
  <settings-entry menu="CFW_LyricsSettings" after="SettingsMenu_ListItem_Brightness" open="CFW_LyricsSettings_Open"/>
</ui>
